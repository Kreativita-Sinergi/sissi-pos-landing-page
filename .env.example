# Salin ke .env.local lalu sesuaikan. Variabel NEXT_PUBLIC_* ditanam saat build.

# Basis URL Sissi POS API (bawaan: https://apipos.sissi.id/api/v1).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# URL situs untuk metadata (bawaan: https://kasir.sissi.id).
# NEXT_PUBLIC_SITE_URL=https://kasir.sissi.id

# Pesan & Bayar Mandiri (QR) — rute /pesan/<kode>. Selain "1", rute ini 404.
NEXT_PUBLIC_SELF_ORDER=0

# Mode tiruan untuk pengembangan: menu & pesanan contoh tanpa server (src/lib/selfOrder/mock.ts).
# JANGAN diset di produksi.
NEXT_PUBLIC_SELF_ORDER_MOCK=0
