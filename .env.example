# Salin ke .env.local lalu sesuaikan. Variabel NEXT_PUBLIC_* ditanam saat build.

# Basis URL Sissi POS API (bawaan: https://apipos.sissi.id/api/v1).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# URL situs untuk metadata (bawaan: https://kasir.sissi.id).
# NEXT_PUBLIC_SITE_URL=https://kasir.sissi.id

# Pesan & Bayar Mandiri (QR) — rute /pesan/<kode>. Selain "1", rute ini 404.
NEXT_PUBLIC_SELF_ORDER=0

# Mode tiruan untuk pengembangan: menu & pesanan contoh tanpa server (src/lib/selfOrder/mock.ts).
# JANGAN diset di produksi.
NEXT_PUBLIC_SELF_ORDER_MOCK=0

# Admin platform (/admin): mode tiruan untuk pengembangan — login & data contoh tanpa server
# (src/lib/admin/mock.ts). Tanpa ini, /admin memanggil NEXT_PUBLIC_API_BASE_URL/admin (server harus
# memuat origin situs ini di ADMIN_ORIGINS). JANGAN diset di produksi.
NEXT_PUBLIC_ADMIN_MOCK=0

# Dasbor pemilik (/masuk, /dasbor): mode tiruan untuk pengembangan — login & data contoh "Kopi Senja"
# tanpa server (src/lib/owner/mock.ts). Email berisi "gratis" → paket Gratis (bagian Pro terkunci).
# Tanpa ini, dasbor memanggil NEXT_PUBLIC_API_BASE_URL/owner (server harus memuat origin situs ini di
# OWNER_WEB_ORIGINS atau ADMIN_ORIGINS). JANGAN diset di produksi.
NEXT_PUBLIC_OWNER_MOCK=0

# Web client ID Google untuk tombol "Masuk dengan Google" di /masuk (harus ada di GOOGLE_OAUTH_CLIENT_IDS
# server, dan origin situs ini terdaftar di Google Cloud Console). Kosong → tombol Google disembunyikan.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
